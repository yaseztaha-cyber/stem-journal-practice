# STEM Journal Practice — environment template
# Copy to .env (root) and backend/.env / frontend/.env as needed.

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://aicommerce:aicommerce_dev@localhost:5432/stem_journal
PGHOST=localhost
PGPORT=5432
PGDATABASE=stem_journal
PGUSER=aicommerce
PGPASSWORD=aicommerce_dev

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# --- Server ---
PORT=4000
FRONTEND_URL=http://localhost:5174
NODE_ENV=development

# --- AI providers (optional; local rubric engine is default) ---
# If set, the server tries the provider first (primary + fallbacks in order),
# validates the output strictly, then falls back to the local engine honestly.
# Default is OpenCode Zen free models (no OPENAI_BASE_URL / OPENAI_MODEL override needed).
# For paid OpenAI instead:
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_MODEL=<your model>
# For Groq (OpenAI-compatible) instead:
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=openai/gpt-oss-120b
#   AI_FALLBACK_MODELS=openai/gpt-oss-20b
# Extra fallback providers, tried in order after Groq (skipped when keyless):
#   AIML_API_KEY= AIML_MODEL=deepseek/deepseek-chat (https://api.aimlapi.com/v1)
#   MISTRAL_API_KEY= MISTRAL_MODEL=mistral-small-latest (https://api.mistral.ai/v1)
# OPENAI_API_KEY=
# OPENAI_MODEL=muse-spark-1.3-contributor-free
# AI_FALLBACK_MODELS=deepseek-v4-flash-free,mimo-v2.5-free
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Admin bootstrap ---
ADMIN_EMAIL=admin@stemjournal.local
ADMIN_PASSWORD=Admin123!
